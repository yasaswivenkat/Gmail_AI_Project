# Groq API Configuration
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Cloud OAuth Credentials Path
# Download this from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GMAIL_CREDENTIALS_FILE=credentials.json

# OAuth Token Storage (automatically generated on first login)
GMAIL_TOKEN_FILE=token.json

# Automation Settings
# Set to true only if you want AI replies to be sent immediately without user review
AUTO_REPLY_AUTO_SEND=false
DEFAULT_REPLY_TONE=professional

